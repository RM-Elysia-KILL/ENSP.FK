<Page
  x:Class="ENSP.ZD.Views.Pages.WorkbenchPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:ENSP.ZD.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:models="clr-namespace:ENSP.ZD.Models"
  xmlns:cfg="clr-namespace:ENSP.ZD.Models.Configuration"

  xmlns:req="clr-namespace:ENSP.ZD.Models.Requirements"
  xmlns:vm="clr-namespace:ENSP.ZD.ViewModels.Pages"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="工作台"
  d:DataContext="{d:DesignInstance local:WorkbenchPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="1200"
  d:DesignWidth="1000"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <helpers:InverseBoolConverter x:Key="InverseBool" xmlns:helpers="clr-namespace:ENSP.ZD.Helpers" />
    <Style x:Key="SectionBorder" TargetType="Border">
      <Setter Property="Padding" Value="12" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style x:Key="SectionExpander" TargetType="Expander">
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="IsExpanded" Value="False" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Page.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">

      <!-- ═══ Page Header ═══ -->
      <TextBlock Margin="0,0,0,4" FontSize="20" FontWeight="SemiBold" Text="工作台" />
      <TextBlock
        Margin="0,0,0,12"
        FontSize="12"
        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
        Text="输入需求 → 一键部署，或按模块逐步操作"
      />

      <!-- ════════════════════════════════════════════════
           Section 1: 拓扑导入
           ════════════════════════════════════════════════ -->
      <Expander Header="1. 拓扑导入" Style="{StaticResource SectionExpander}">
        <Border Style="{StaticResource SectionBorder}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: File input -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
              <TextBox
                MinWidth="200"
                MaxWidth="500"
                VerticalAlignment="Center"
                Text="{Binding ViewModel.TopoFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              />
              <ui:Button
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding ViewModel.BrowseTopoFileCommand}"
                Content="浏览"
                Icon="FolderOpen24"
              />
              <ui:Button
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding ViewModel.ParseTopologyCommand}"
                Content="解析"
                Icon="ArrowSync24"
                Appearance="Primary"
              />
              <ui:Button
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding ViewModel.OpenTopoInEnspCommand}"
                Content="打开拓扑"
                Icon="Open24"
              />
              <Border
                Width="1"
                Margin="12,4,4,4"
                Background="{DynamicResource CardStrokeFillColorDefaultBrush}"
              />
              <ui:Button
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding ViewModel.OneClickAllCommand}"
                Content="一键部署"
                Icon="ArrowSync24"
                Appearance="Success"
                FontWeight="SemiBold"
                IsEnabled="{Binding ViewModel.CanOneClickDeploy, Mode=OneWay}"
                ToolTipService.ShowOnDisabled="True"
                ToolTip="{Binding ViewModel.OneClickDeployToolTip, Mode=OneWay}"
              />
              <TextBlock
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding ViewModel.OneClickStatus, Mode=OneWay}"
              />
            </StackPanel>

            <!-- Row 1: Status -->
            <TextBlock
              Grid.Row="1"
              Margin="0,8,0,0"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="{Binding ViewModel.TopoStatus, Mode=OneWay}"
            />

            <!-- Row 2: Device DataGrid -->
            <DataGrid
              Grid.Row="2"
              Margin="0,8,0,0"
              MaxHeight="200"
              AutoGenerateColumns="False"
              HeadersVisibility="Column"
              IsReadOnly="True"
              ItemsSource="{Binding ViewModel.ImportedDevices, Mode=OneWay}"
              Visibility="{Binding ViewModel.IsTopoLoaded, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            >
              <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Name, Mode=OneWay}" Header="设备名称" Width="120" />
                <DataGridTextColumn Binding="{Binding Type, Mode=OneWay}" Header="类型" Width="80" />
                <DataGridTextColumn Binding="{Binding ConsolePort, Mode=OneWay}" Header="Console 端口" Width="100" />
                <DataGridTextColumn Binding="{Binding Interfaces.Count, Mode=OneWay}" Header="接口数" Width="80" />
              </DataGrid.Columns>
            </DataGrid>

            <!-- Row 3: Link summary -->
            <TextBlock
              Grid.Row="3"
              Margin="0,4,0,0"
              FontSize="12"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Text="{Binding ViewModel.LinkCount, Mode=OneWay, StringFormat='链路数量: {0}'}"
              Visibility="{Binding ViewModel.IsTopoLoaded, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            />
          </Grid>
        </Border>
      </Expander>

      <!-- ════════════════════════════════════════════════
           Section 2: 需求配置
           ════════════════════════════════════════════════ -->
      <Expander Header="2. 需求配置" Style="{StaticResource SectionExpander}">
        <Border Style="{StaticResource SectionBorder}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="200" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="380" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Left: free-text prompt -->
            <Grid Grid.Column="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="300" />
              </Grid.RowDefinitions>
              <TextBlock
                Grid.Row="0"
                Margin="0,0,0,4"
                FontWeight="SemiBold"
                Text="自由文本描述（直接粘贴需求，AI 自动理解）"
              />
              <TextBox
                Grid.Row="1"
                AcceptsReturn="True"
                Text="{Binding ViewModel.RawRequirementText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"
              />
            </Grid>

            <!-- Right: structured form -->
            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock
                Grid.Row="0"
                Margin="0,0,0,6"
                FontWeight="SemiBold"
                Text="结构化添加"
              />

              <!-- Device selector -->
              <ComboBox
                Grid.Row="1"
                ItemsSource="{Binding ViewModel.AvailableDevices, Mode=OneWay}"
                SelectedItem="{Binding ViewModel.SelectedReqDevice, Mode=TwoWay}"
                DisplayMemberPath="Name"
                IsSynchronizedWithCurrentItem="False"
              />

              <!-- Type selector -->
              <ComboBox
                Grid.Row="2"
                Margin="0,6,0,0"
                ItemsSource="{Binding ViewModel.ReqTypes, Mode=OneTime}"
                SelectedItem="{Binding ViewModel.SelectedReqType, Mode=TwoWay}"
              />

              <!-- Dynamic form: Interface IP -->
              <StackPanel Grid.Row="3" Margin="0,6,0,0">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ViewModel.SelectedReqType}" Value="接口 IP">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                    <Setter Property="Visibility" Value="Collapsed" />
                  </Style>
                </StackPanel.Style>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="接口名" />
                <TextBox Text="{Binding ViewModel.IfName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: GigabitEthernet0/0/0" />
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="IP 地址" />
                <TextBox Margin="0,2,0,0" Text="{Binding ViewModel.IfIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: 10.0.1.1" />
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="子网掩码" />
                <TextBox Margin="0,2,0,0" Text="{Binding ViewModel.IfMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: 255.255.255.0" />
              </StackPanel>

              <!-- Dynamic form: VLAN -->
              <StackPanel Grid.Row="3" Margin="0,6,0,0">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ViewModel.SelectedReqType}" Value="VLAN">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                    <Setter Property="Visibility" Value="Collapsed" />
                  </Style>
                </StackPanel.Style>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="VLAN ID" />
                <TextBox Text="{Binding ViewModel.VlanId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: 10" />
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="VLAN 名称" />
                <TextBox Margin="0,2,0,0" Text="{Binding ViewModel.VlanName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: vlan10" />
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Access 端口（逗号分隔）" />
                <TextBox Margin="0,2,0,0" Text="{Binding ViewModel.VlanAccessPorts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: GigabitEthernet0/0/1, GigabitEthernet0/0/2" />
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Trunk 端口（逗号分隔）" />
                <TextBox Margin="0,2,0,0" Text="{Binding ViewModel.VlanTrunkPorts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: GigabitEthernet0/0/3" />
              </StackPanel>

              <!-- Dynamic form: OSPF -->
              <StackPanel Grid.Row="3" Margin="0,6,0,0">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ViewModel.SelectedReqType}" Value="OSPF">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                    <Setter Property="Visibility" Value="Collapsed" />
                  </Style>
                </StackPanel.Style>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="进程 ID" />
                <TextBox Text="{Binding ViewModel.OspfProcessId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: 1" />
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Router ID" />
                <TextBox Margin="0,2,0,0" Text="{Binding ViewModel.OspfRouterId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: 1.1.1.1" />
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Area ID" />
                <TextBox Margin="0,2,0,0" Text="{Binding ViewModel.OspfAreaId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: 0" />
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="网段（逗号分隔，CIDR格式）" />
                <TextBox Margin="0,2,0,0" Text="{Binding ViewModel.OspfNetworks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: 10.0.1.0/24, 10.0.2.0/24" />
              </StackPanel>

              <!-- Dynamic form: Static Route -->
              <StackPanel Grid.Row="3" Margin="0,6,0,0">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ViewModel.SelectedReqType}" Value="静态路由">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                    <Setter Property="Visibility" Value="Collapsed" />
                  </Style>
                </StackPanel.Style>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="目标网段" />
                <TextBox Text="{Binding ViewModel.RouteDest, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: 192.168.0.0" />
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="子网掩码" />
                <TextBox Margin="0,2,0,0" Text="{Binding ViewModel.RouteMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: 255.255.255.0" />
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="下一跳" />
                <TextBox Margin="0,2,0,0" Text="{Binding ViewModel.RouteNextHop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: 10.0.1.1" />
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="出接口（可选）" />
                <TextBox Margin="0,2,0,0" Text="{Binding ViewModel.RouteOutIf, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: GigabitEthernet0/0/1" />
              </StackPanel>

              <!-- Dynamic form: ACL -->
              <StackPanel Grid.Row="3" Margin="0,6,0,0">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ViewModel.SelectedReqType}" Value="ACL">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                    <Setter Property="Visibility" Value="Collapsed" />
                  </Style>
                </StackPanel.Style>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="ACL 编号" />
                <TextBox Text="{Binding ViewModel.AclNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: 3000" />
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="动作" />
                <TextBox Margin="0,2,0,0" Text="{Binding ViewModel.AclAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="permit 或 deny" />
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="协议" />
                <TextBox Margin="0,2,0,0" Text="{Binding ViewModel.AclProtocol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: ip" />
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="源地址" />
                <TextBox Margin="0,2,0,0" Text="{Binding ViewModel.AclSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: 10.0.1.0 0.0.0.255" />
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="目标地址" />
                <TextBox Margin="0,2,0,0" Text="{Binding ViewModel.AclDest, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: 10.0.2.0 0.0.0.255" />
              </StackPanel>

              <!-- Add button -->
              <ui:Button
                Grid.Row="4"
                Margin="0,8,0,0"
                HorizontalAlignment="Stretch"
                Command="{Binding ViewModel.AddRequirementCommand}"
                Content="添加需求"
                Icon="Add24"
                Appearance="Primary"
              />

              <!-- Req status -->
              <TextBlock
                Grid.Row="5"
                Margin="0,4,0,0"
                FontSize="11"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="{Binding ViewModel.ReqStatus, Mode=OneWay}"
              />

              <!-- Requirement list -->
              <ListBox
                Grid.Row="6"
                Margin="0,8,0,0"
                ItemsSource="{Binding ViewModel.AddedRequirements, Mode=OneWay}"
              >
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type req:TaskRequirement}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Margin="2,2" Orientation="Horizontal">
                        <TextBlock
                          VerticalAlignment="Center"
                          FontWeight="SemiBold"
                          Text="{Binding DeviceName, Mode=OneWay}"
                        />
                        <TextBlock
                          Margin="6,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding RequirementType, Mode=OneWay}"
                        />
                      </StackPanel>
                      <ui:Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Command="{Binding DataContext.ViewModel.DeleteRequirementCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding}"
                        Content="删除"
                        Icon="Dismiss12"
                        Appearance="Danger"
                        FontSize="10"
                      />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

            </Grid>
          </Grid>
        </Border>
      </Expander>

      <!-- ════════════════════════════════════════════════
           Section 3: 配置生成
           ════════════════════════════════════════════════ -->
      <Expander Header="3. 配置生成" Style="{StaticResource SectionExpander}">
        <Border Style="{StaticResource SectionBorder}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Action buttons -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
              <ui:Button
                VerticalAlignment="Center"
                Command="{Binding ViewModel.GenerateConfigsCommand}"
                Content="生成配置"
                Icon="Play24"
                Appearance="Primary"
                IsEnabled="{Binding ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource InverseBool}}"
              />
              <ui:Button
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding ViewModel.ShowAllConfigsCommand}"
                Content="显示全部"
                Icon="List24"
              />
              <ui:Button
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding ViewModel.CopyToClipboardCommand}"
                Content="复制"
                Icon="Copy24"
              />
              <ui:Button
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding ViewModel.ExportToFilesCommand}"
                Content="导出"
                Icon="Save24"
              />
              <ui:Button
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding ViewModel.VerifyConfigsCommand}"
                Content="验证"
                Icon="Checkmark24"
                IsEnabled="{Binding ViewModel.IsVerifying, Mode=OneWay, Converter={StaticResource InverseBool}}"
              />
              <ui:Button
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding ViewModel.ClearAllCacheCommand}"
                Content="清除"
                Icon="Delete24"
              />
              <Border
                Width="1"
                Margin="12,4,4,4"
                Background="{DynamicResource CardStrokeFillColorDefaultBrush}"
              />
              <ui:Button
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding ViewModel.OneClickDeployCommand}"
                Content="仅推送配置"
                Icon="ArrowSync24"
                Appearance="Secondary"
                IsEnabled="{Binding ViewModel.IsDeploying, Mode=OneWay, Converter={StaticResource InverseBool}}"
              />
            </StackPanel>

            <!-- Row 1: Device list + Config preview -->
            <Grid Grid.Row="1" Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <ListBox
                Grid.Column="0"
                ItemsSource="{Binding ViewModel.DeviceConfigs, Mode=OneWay}"
                SelectedItem="{Binding ViewModel.SelectedDeviceConfig, Mode=TwoWay}"
              >
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type cfg:DeviceConfig}">
                    <StackPanel Margin="2,3" Orientation="Horizontal">
                      <ui:SymbolIcon
                        Width="14"
                        Height="14"
                        Margin="0,0,6,0"
                        Symbol="Server24"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      />
                      <TextBlock VerticalAlignment="Center" Text="{Binding DeviceName, Mode=OneWay}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Border
                Grid.Column="1"
                Margin="8,0,0,0"
                BorderBrush="{DynamicResource CardStrokeFillColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
              >
                <TextBox
                  Margin="8"
                  Background="Transparent"
                  BorderThickness="0"
                  FontFamily="Consolas, Courier New, monospace"
                  FontSize="12"
                  IsReadOnly="True"
                  MaxHeight="250"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Text="{Binding ViewModel.ConfigText, Mode=OneWay}"
                  TextWrapping="NoWrap"
                />
              </Border>
            </Grid>

            <!-- Row 2: Status -->
            <StackPanel Grid.Row="2" Margin="0,6,0,0" Orientation="Horizontal">
              <TextBlock
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding ViewModel.GenStatusMessage, Mode=OneWay}"
              />
              <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                Text="{Binding ViewModel.ElapsedTime, Mode=OneWay}"
                Visibility="{Binding ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource BoolToVis}}"
              />
              <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding ViewModel.DeployStatus, Mode=OneWay}"
              />
            </StackPanel>

            <!-- Row 3: AI Trace sub-expander -->
            <Expander
              Grid.Row="3"
              Margin="0,6,0,0"
              Header="AI 对话追踪"
              IsExpanded="False"
              FontSize="12"
              FontWeight="Normal"
            >
              <ListBox
                MaxHeight="150"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding ViewModel.ChatMessages, Mode=OneWay}"
              >
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type models:ChatMessage}">
                    <Border
                      Margin="0,2"
                      Padding="10,6"
                      CornerRadius="6"
                      MaxWidth="700"
                    >
                      <Border.Style>
                        <Style TargetType="Border">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                              <Setter Property="HorizontalAlignment" Value="Right" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAi}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                              <Setter Property="HorizontalAlignment" Value="Left" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsStatus}" Value="True">
                              <Setter Property="Background" Value="Transparent" />
                              <Setter Property="HorizontalAlignment" Value="Center" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <StackPanel>
                        <TextBlock
                          FontSize="11"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        >
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                  <Setter Property="Text" Value="你" />
                                  <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAi}" Value="True">
                                  <Setter Property="Text" Value="AI" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsStatus}" Value="True">
                                  <Setter Property="Text" Value="系统" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock
                          FontSize="12"
                          Text="{Binding Content, Mode=OneWay}"
                          TextWrapping="Wrap"
                        >
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                  <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Expander>
          </Grid>
        </Border>
      </Expander>

      <!-- ════════════════════════════════════════════════
           Section 4: 设备管控
           ════════════════════════════════════════════════ -->
      <Expander Header="4. 设备管控" Style="{StaticResource SectionExpander}">
        <Border Style="{StaticResource SectionBorder}" Padding="0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="280" MinWidth="220" />
              <ColumnDefinition Width="*" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <!-- Left: Device list -->
            <Border
              Grid.Column="0"
              Padding="10"
              Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
              CornerRadius="6,0,0,6"
            >
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="0,0,0,8" FontSize="14" FontWeight="SemiBold" Text="设备列表" />
                <ListBox
                  Grid.Row="1"
                  ItemsSource="{Binding ViewModel.Devices, Mode=OneWay}"
                  SelectedItem="{Binding ViewModel.SelectedDevice, Mode=TwoWay}"
                  Background="Transparent"
                  BorderThickness="0"
                >
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DeviceItem}">
                      <Border Margin="2,3" Padding="4" CornerRadius="4">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>

                          <!-- Icon -->
                          <ui:SymbolIcon
                            Grid.Row="0" Grid.Column="0"
                            Width="18" Height="18"
                            Symbol="Globe24"
                            VerticalAlignment="Center"
                          />

                          <!-- Name + Type -->
                          <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="Medium" Text="{Binding Name, Mode=OneWay}" />
                            <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                              <Run Text="{Binding DeviceTypeText, Mode=OneWay}" />
                              <Run Text=" — " />
                              <Run Text="{Binding Address, Mode=OneWay}" />
                            </TextBlock>
                          </StackPanel>

                          <!-- Status indicators -->
                          <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Busy indicator -->
                            <Ellipse Width="8" Height="8" Margin="0,0,4,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                              <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding RuntimeState}" Value="Cloning">
                                      <Setter Property="Fill" Value="#FF9800" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RuntimeState}" Value="Booting">
                                      <Setter Property="Fill" Value="#2196F3" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RuntimeState}" Value="Error">
                                      <Setter Property="Fill" Value="#F44336" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RuntimeState}" Value="Stopping">
                                      <Setter Property="Fill" Value="#FF9800" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Ellipse.Style>
                            </Ellipse>
                            <!-- Ready indicator -->
                            <Ellipse Width="8" Height="8" Margin="0,0,4,0" Fill="#4CAF50" VerticalAlignment="Center">
                              <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding RuntimeState}" Value="Ready">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Ellipse.Style>
                            </Ellipse>
                            <!-- Connected icon -->
                            <ui:SymbolIcon
                              Width="12" Height="12"
                              Foreground="#4CAF50"
                              Symbol="CheckmarkCircle24"
                              VerticalAlignment="Center"
                              Visibility="{Binding IsConnected, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            />
                          </StackPanel>

                          <!-- Progress bar -->
                          <ProgressBar
                            Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                            Height="4" Margin="0,5,0,2"
                            Maximum="100" Minimum="0"
                            Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            Value="{Binding StartupProgress, Mode=OneWay}"
                          />
                          <!-- Phase text -->
                          <TextBlock
                            Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                            FontSize="9"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                          >
                            <Run Text="{Binding StartupPhase, Mode=OneWay}" />
                            <Run Text=" — " />
                            <Run Text="{Binding StartupDetail, Mode=OneWay}" />
                          </TextBlock>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <!-- Right: Terminal Panel -->
            <Border
              Grid.Column="1"
              Margin="0"
              BorderBrush="{DynamicResource CardStrokeFillColorDefaultBrush}"
              BorderThickness="1,0,0,0"
            >
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Device info header -->
                <Border
                  Grid.Row="0"
                  Padding="12,8"
                  Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                >
                  <Grid>
                    <TextBlock VerticalAlignment="Center" FontSize="13">
                      <Run FontWeight="SemiBold" Text="{Binding ViewModel.SelectedDevice.Name, Mode=OneWay, FallbackValue='未选择设备'}" />
                      <Run Text="  " />
                      <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding ViewModel.SelectedDevice.Address, Mode=OneWay, FallbackValue=''}" />
                    </TextBlock>
                    <TextBlock
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      FontSize="11"
                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                      Text="{Binding ViewModel.ControlStatus, Mode=OneWay}"
                    />
                  </Grid>
                </Border>

                <!-- Action buttons -->
                <WrapPanel Grid.Row="1" Margin="10,6">
                  <ui:Button
                    Command="{Binding ViewModel.StartAllDevicesCommand}"
                    Content="启动全部"
                    Icon="Play24"
                    Appearance="Success"
                    ToolTip="通过 eNSP 窗口自动图像识别点击启动"
                    IsEnabled="{Binding ViewModel.IsStartingDevices, Mode=OneWay, Converter={StaticResource InverseBool}}"
                  />
                  <ui:Button
                    Margin="6,0,0,0"
                    Command="{Binding ViewModel.StopAllDevicesCommand}"
                    Content="停止全部"
                    Icon="DismissCircle24"
                  />
                  <ui:Button
                    Margin="6,0,0,0"
                    Command="{Binding ViewModel.ConnectAllDevicesCommand}"
                    Content="连接全部"
                    Icon="PlugConnected24"
                    Appearance="Primary"
                    IsEnabled="{Binding ViewModel.IsConnecting, Mode=OneWay, Converter={StaticResource InverseBool}}"
                  />
                  <ui:Button
                    Margin="6,0,0,0"
                    Command="{Binding ViewModel.DisconnectAllDevicesCommand}"
                    Content="断开全部"
                    Icon="PlugDisconnected24"
                  />
                  <Border Margin="12,4" Width="1" Background="{DynamicResource CardStrokeFillColorDefaultBrush}" />
                  <ui:Button
                    Margin="6,0,0,0"
                    Command="{Binding ViewModel.ConnectDeviceCommand}"
                    CommandParameter="{Binding ViewModel.SelectedDevice}"
                    Content="连接选中"
                    Icon="Play24"
                  />
                  <ui:Button
                    Margin="6,0,0,0"
                    Command="{Binding ViewModel.DisconnectDeviceCommand}"
                    Content="断开选中"
                    Icon="DismissCircle24"
                    IsEnabled="{Binding ViewModel.IsConnected, Mode=OneWay}"
                  />
                  <Border Margin="12,4" Width="1" Background="{DynamicResource CardStrokeFillColorDefaultBrush}" />
                  <ui:Button
                    Margin="6,0,0,0"
                    Command="{Binding ViewModel.PushConfigToAllDevicesCommand}"
                    Content="配置全部"
                    Icon="Send24"
                    Appearance="Success"
                  />
                  <ui:Button
                    Margin="6,0,0,0"
                    Command="{Binding ViewModel.PushConfigToSelectedDeviceCommand}"
                    Content="配置选中"
                    Icon="ArrowSync24"
                    Appearance="Primary"
                    IsEnabled="{Binding ViewModel.IsConnected, Mode=OneWay}"
                  />
                  <ui:Button
                    Margin="6,0,0,0"
                    Command="{Binding ViewModel.FetchDeviceConfigCommand}"
                    Content="获取配置"
                    Icon="CloudDownload24"
                    IsEnabled="{Binding ViewModel.IsConnected, Mode=OneWay}"
                  />
                  <ui:Button
                    Margin="6,0,0,0"
                    Command="{Binding ViewModel.OpenDeviceConfigPopupCommand}"
                    Content="编辑配置"
                    Icon="Code24"
                  />
                </WrapPanel>

                <!-- Terminal -->
                <Border
                  Grid.Row="2"
                  Grid.RowSpan="2"
                  Margin="10,4"
                  CornerRadius="8"
                  BorderBrush="#333333"
                  BorderThickness="1"
                  Background="#1E1E1E"
                >
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Terminal output -->
                    <ScrollViewer
                      VerticalScrollBarVisibility="Auto"
                    >
                      <TextBlock
                        Padding="10,8"
                        FontFamily="Consolas, Courier New, monospace"
                        FontSize="12"
                        Foreground="#E0E0E0"
                        Text="{Binding ViewModel.TerminalOutput, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Background="Transparent"
                      />
                    </ScrollViewer>

                    <!-- Command input -->
                    <Border
                      Grid.Row="1"
                      Padding="10,6"
                      BorderBrush="#333333"
                      BorderThickness="0,1,0,0"
                      Background="Transparent"
                    >
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                          Grid.Column="0"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          FontFamily="Consolas, Courier New, monospace"
                          FontWeight="Bold"
                          Foreground="#4EC9B0"
                          Text=">"
                        />
                        <TextBox
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          FontFamily="Consolas, Courier New, monospace"
                          FontSize="12"
                          Foreground="#E0E0E0"
                          CaretBrush="#E0E0E0"
                          Background="Transparent"
                          BorderThickness="0"
                          Text="{Binding ViewModel.CommandInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        >
                          <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ViewModel.SendCommandCommand}" />
                          </TextBox.InputBindings>
                        </TextBox>
                        <ui:Button
                          Grid.Column="2"
                          Margin="6,0,0,0"
                          Padding="6,4"
                          Command="{Binding ViewModel.SendCommandCommand}"
                          Content="发送"
                          Icon="Send24"
                          IsEnabled="{Binding ViewModel.IsConnected, Mode=OneWay}"
                        />
                      </Grid>
                    </Border>
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Expander>

      <!-- ════════════════════════════════════════════════
           Section 5: 验证审核
           ════════════════════════════════════════════════ -->
      <Expander Style="{StaticResource SectionExpander}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="5. 验证审核（仅检查）" />
            <Border
              Margin="8,0,0,0"
              Padding="5,2"
              VerticalAlignment="Center"
              Background="#FFF3E0"
              CornerRadius="3"
            >
              <TextBlock
                FontSize="10"
                Foreground="#E65100"
                Text="正在完善，暂时无用"
              />
            </Border>
          </StackPanel>
        </Expander.Header>
        <Border Style="{StaticResource SectionBorder}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:Button
                Grid.Column="0"
                VerticalAlignment="Center"
                Command="{Binding ViewModel.RunVerificationCommand}"
                Content="运行验证"
                Icon="Checkmark24"
                Appearance="Primary"
                IsEnabled="{Binding ViewModel.IsVerifying2, Mode=OneWay, Converter={StaticResource InverseBool}}"
              />
              <TextBlock
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding ViewModel.VerifyStatus, Mode=OneWay}"
              />
            </Grid>
            <TextBox
              Margin="0,8,0,0"
              MinHeight="120"
              AcceptsReturn="True"
              Background="Transparent"
              FontFamily="Consolas, Courier New, monospace"
              FontSize="12"
              IsReadOnly="True"
              Text="{Binding ViewModel.VerifyResultText, Mode=OneWay}"
              TextWrapping="Wrap"
              VerticalScrollBarVisibility="Auto"
            />
          </StackPanel>
        </Border>
      </Expander>

    </StackPanel>
  </ScrollViewer>
</Page>
