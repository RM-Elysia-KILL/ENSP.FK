<Page
  x:Class="ENSP.ZD.Views.Pages.DashboardPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:ENSP.ZD.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:helpers="clr-namespace:ENSP.ZD.Helpers"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="首页"
  d:DataContext="{d:DesignInstance local:DashboardPage,
                                     IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Viewbox Stretch="Uniform" StretchDirection="UpOnly">
    <Grid Width="800">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock
        HorizontalAlignment="Center"
        FontSize="24"
        FontWeight="SemiBold"
        Text="ENSP.ZD — eNSP 自动配置工具"
      />
      <TextBlock
        Margin="0,16,0,0"
        HorizontalAlignment="Center"
        FontSize="14"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="自动配置功能在「工作台」页面中"
      />
      <TextBlock
        Margin="0,8,0,0"
        HorizontalAlignment="Center"
        FontSize="12"
        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
        Text="其余模块（数据、诊断、设置 等）均为开发测试用途"
      />
    </StackPanel>
    </Grid>
  </Viewbox>
</Page>
