<Page
  x:Class="ENSP.ZD.Views.Pages.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helpers="clr-namespace:ENSP.ZD.Helpers"
  xmlns:local="clr-namespace:ENSP.ZD.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="设置"
  d:DataContext="{d:DesignInstance local:SettingsPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="600"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    <helpers:InverseBoolConverter x:Key="InverseBool" />
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <!-- Theme -->
      <TextBlock FontSize="20" FontWeight="Medium" Text="个性化" />
      <TextBlock Margin="0,12,0,0" Text="主题" />
      <RadioButton
        Margin="0,12,0,0"
        Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
        CommandParameter="theme_light"
        Content="浅色"
        GroupName="themeSelect"
        IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}"
      />
      <RadioButton
        Margin="0,8,0,0"
        Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
        CommandParameter="theme_dark"
        Content="深色"
        GroupName="themeSelect"
        IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}"
      />

      <!-- API Configuration -->
      <TextBlock Margin="0,32,0,0" FontSize="20" FontWeight="Medium" Text="AI API 配置" />
      <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="配置 DeepSeek API 用于智能生成网络设备配置" />

      <TextBlock Margin="0,16,0,4" Text="Base URL (OpenAI 兼容)" />
      <TextBox Text="{Binding ViewModel.BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Margin="0,12,0,4" Text="API Key" />
      <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged" />

      <TextBlock Margin="0,12,0,4" Text="模型名称" />
      <TextBox Text="{Binding ViewModel.ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

      <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
        <ui:Button
          Command="{Binding ViewModel.SaveApiConfigCommand, Mode=OneWay}"
          Content="保存配置"
          Icon="Save24"
          Appearance="Primary"
        />
        <ui:Button
          Margin="8,0,0,0"
          Command="{Binding ViewModel.TestConnectionCommand, Mode=OneWay}"
          Content="连通性测试"
          Icon="ArrowSync24"
          IsEnabled="{Binding ViewModel.IsTesting, Mode=OneWay, Converter={StaticResource InverseBool}}"
        />
        <TextBlock
          Margin="12,0,0,0"
          VerticalAlignment="Center"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="{Binding ViewModel.ApiStatus, Mode=OneWay}"
        />
      </StackPanel>

      <!-- eNSP Configuration -->
      <TextBlock Margin="0,32,0,0" FontSize="20" FontWeight="Medium" Text="eNSP 配置" />
      <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="设置 eNSP 模拟器的安装路径" />

      <TextBlock Margin="0,16,0,4" Text="eNSP 安装路径（文件夹或 .exe 完整路径）" />
      <TextBox Text="{Binding ViewModel.EnspPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Margin="0,16,0,4" Text="配置命令存放路径（留空使用默认）" />
      <TextBox Text="{Binding ViewModel.ConfigOutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

      <!-- Image Recognition Template Capture -->
      <TextBlock Margin="0,32,0,0" FontSize="20" FontWeight="Medium" Text="图像识别模板" />
      <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="截取 eNSP 画布上的设备图标作为模板，提高图像识别准确率。操作：输入设备型号 → 点击截取 → 窗口自动最小化 → 5 秒内将鼠标移到 eNSP 设备图标上" />

      <TextBlock Margin="0,16,0,4" Text="设备型号（如 AR1220, S5700）" />
      <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox
          Grid.Column="0"
          Text="{Binding ViewModel.CaptureModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          IsEnabled="{Binding ViewModel.IsCapturing, Mode=OneWay, Converter={StaticResource InverseBool}}"
        />
        <ui:Button
          Grid.Column="1"
          Margin="8,0,0,0"
          Command="{Binding ViewModel.StartCaptureCommand, Mode=OneWay}"
          Content="截取图标"
          Icon="Image24"
          Appearance="Primary"
          IsEnabled="{Binding ViewModel.IsCapturing, Mode=OneWay, Converter={StaticResource InverseBool}}"
        />
      </Grid>

      <TextBlock
        Margin="0,8,0,0"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{Binding ViewModel.CaptureStatus, Mode=OneWay}"
      />

      <!-- About -->
      <TextBlock Margin="0,32,0,0" FontSize="20" FontWeight="Medium" Text="关于" />
      <TextBlock Margin="0,12,0,0" Text="{Binding ViewModel.AppVersion, Mode=OneWay}" />
      <ui:Button
        Margin="0,12,0,0"
        Command="{Binding ViewModel.ShowChangelogCommand}"
        Content="更新公告"
        Icon="Megaphone24"
        Appearance="Info"
      />
      <Button
        Margin="0,6,0,0"
        Padding="0"
        Background="Transparent"
        BorderThickness="0"
        Command="{Binding ViewModel.OpenGitHubCommand}"
        Cursor="Hand"
      >
        <TextBlock
          Foreground="{DynamicResource SystemAccentColorBrush}"
          TextDecorations="Underline"
          Text="{Binding ViewModel.GitHubUrl, Mode=OneWay}"
        />
      </Button>
    </StackPanel>
  </ScrollViewer>
</Page>
