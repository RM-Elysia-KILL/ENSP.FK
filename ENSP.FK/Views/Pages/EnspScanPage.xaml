<Page
  x:Class="ENSP.FK.Views.Pages.EnspScanPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helpers="clr-namespace:ENSP.FK.Helpers"
  xmlns:local="clr-namespace:ENSP.FK.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:ENSP.FK.ViewModels.Pages"
  Title="ENSP 扫描"
  d:DataContext="{d:DesignInstance local:EnspScanPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="600"
  d:DesignWidth="1000"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <helpers:InverseBoolConverter x:Key="InverseBool" />
  </Page.Resources>

  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Device List Panel -->
    <Border
      Grid.Column="0"
      Padding="12"
      BorderBrush="{DynamicResource CardStrokeFillColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="6"
    >
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Margin="0,0,0,8" FontSize="15" FontWeight="SemiBold" Text="设备列表" />

        <ListBox
          Grid.Row="1"
          ItemsSource="{Binding ViewModel.Devices, Mode=OneWay}"
          SelectedItem="{Binding ViewModel.SelectedDevice, Mode=TwoWay}"
        >
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:DeviceItem">
              <Grid Margin="4,5" ColumnDefinitions="Auto,*,Auto">
                <ui:SymbolIcon
                  Grid.Column="0"
                  Width="20"
                  Height="20"
                  Symbol="Globe24"
                  VerticalAlignment="Center"
                />
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Name, Mode=OneWay}" />
                  <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="{Binding DeviceTypeText, Mode=OneWay}" />
                    <Run Text=" — " />
                    <Run Text="{Binding Address, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>
                <ui:SymbolIcon
                  Grid.Column="2"
                  Width="14"
                  Height="14"
                  Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                  Symbol="CheckmarkCircle24"
                  VerticalAlignment="Center"
                  Visibility="{Binding IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- Terminal Panel -->
    <Border
      Grid.Column="1"
      Margin="12,0,0,0"
      BorderBrush="{DynamicResource CardStrokeFillColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="6"
    >
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Device info + status bar -->
        <Border
          Grid.Row="0"
          Padding="12,10"
          Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
          CornerRadius="6,6,0,0"
        >
          <Grid>
            <TextBlock VerticalAlignment="Center" FontSize="14">
              <Run FontWeight="SemiBold" Text="{Binding ViewModel.SelectedDevice.Name, Mode=OneWay, FallbackValue='未选择设备'}" />
              <Run Text="  " />
              <Run
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding ViewModel.SelectedDevice.Address, Mode=OneWay, FallbackValue=''}"
              />
            </TextBlock>
            <TextBlock
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              FontSize="12"
              Text="{Binding ViewModel.StatusText, Mode=OneWay}"
            />
          </Grid>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="1" Margin="12,8" Orientation="Horizontal">
          <ui:Button
            Command="{Binding ViewModel.ConnectAllDevicesCommand, Mode=OneWay}"
            Content="一键连接全部"
            Icon="PlugConnected24"
            Appearance="Primary"
            IsEnabled="{Binding ViewModel.IsConnecting, Mode=OneWay, Converter={StaticResource InverseBool}}"
          />
          <ui:Button
            Margin="8,0,0,0"
            Command="{Binding ViewModel.DisconnectAllDevicesCommand, Mode=OneWay}"
            Content="断开全部"
            Icon="PlugDisconnected24"
          />
          <ui:Button
            Margin="16,0,0,0"
            Command="{Binding ViewModel.ConnectDeviceCommand, Mode=OneWay}"
            CommandParameter="{Binding ViewModel.SelectedDevice, Mode=OneWay}"
            Content="连接选中"
            Icon="Play24"
            IsEnabled="{Binding ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource InverseBool}}"
          />
          <ui:Button
            Margin="8,0,0,0"
            Command="{Binding ViewModel.DisconnectDeviceCommand, Mode=OneWay}"
            Content="断开选中"
            Icon="DismissCircle24"
            IsEnabled="{Binding ViewModel.IsConnected, Mode=OneWay}"
          />
          <Border Margin="16,4" Width="1" Background="{DynamicResource CardStrokeFillColorDefaultBrush}" />
          <ui:Button
            Margin="16,0,0,0"
            Command="{Binding ViewModel.PushConfigToAllDevicesCommand, Mode=OneWay}"
            Content="一键配置全部"
            Icon="Send24"
            Appearance="Success"
            IsEnabled="{Binding ViewModel.IsPushing, Mode=OneWay, Converter={StaticResource InverseBool}}"
          />
          <ui:Button
            Margin="8,0,0,0"
            Command="{Binding ViewModel.PushConfigToSelectedDeviceCommand, Mode=OneWay}"
            Content="配置选中"
            Icon="ArrowSync24"
            IsEnabled="{Binding ViewModel.IsConnected, Mode=OneWay}"
          />
        </StackPanel>

        <!-- Terminal output -->
        <ScrollViewer
          Grid.Row="2"
          Margin="12,4"
          VerticalScrollBarVisibility="Auto"
        >
          <TextBlock
            Padding="4"
            FontFamily="Consolas, Courier New, monospace"
            FontSize="13"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="{Binding ViewModel.TerminalOutput, Mode=OneWay}"
            TextWrapping="Wrap"
          />
        </ScrollViewer>

        <!-- Command input -->
        <Border
          Grid.Row="3"
          Padding="12,8"
          Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
          CornerRadius="0,0,6,6"
        >
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
              Grid.Column="0"
              Margin="0,0,8,0"
              VerticalAlignment="Center"
              FontFamily="Consolas, Courier New, monospace"
              FontWeight="Bold"
              Text=">"
            />
            <TextBox
              Grid.Column="1"
              VerticalAlignment="Center"
              FontFamily="Consolas, Courier New, monospace"
              FontSize="13"
              Text="{Binding ViewModel.CommandInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            >
              <TextBox.InputBindings>
                <KeyBinding
                  Key="Enter"
                  Command="{Binding ViewModel.SendCommandCommand, Mode=OneWay}"
                />
              </TextBox.InputBindings>
            </TextBox>
            <ui:Button
              Grid.Column="2"
              Margin="8,0,0,0"
              Padding="8,6"
              Command="{Binding ViewModel.SendCommandCommand, Mode=OneWay}"
              Content="发送"
              Icon="Send24"
              IsEnabled="{Binding ViewModel.IsConnected, Mode=OneWay}"
            />
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Page>
