<Page
  x:Class="ENSP.ZD.Views.Pages.EnspScanPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helpers="clr-namespace:ENSP.ZD.Helpers"
  xmlns:local="clr-namespace:ENSP.ZD.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:ENSP.ZD.ViewModels.Pages"
  Title="ENSP 扫描"
  d:DataContext="{d:DesignInstance local:EnspScanPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="600"
  d:DesignWidth="1000"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <helpers:InverseBoolConverter x:Key="InverseBool" />
  </Page.Resources>

  <Viewbox Stretch="Uniform" StretchDirection="UpOnly">
    <Grid Margin="16" Width="800">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="200" MaxWidth="400" />
      <ColumnDefinition Width="3*" />
    </Grid.ColumnDefinitions>

    <!-- Device List Panel -->
    <Border
      Grid.Column="0"
      Padding="12"
      BorderBrush="{DynamicResource CardStrokeFillColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="6"
    >
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Margin="0,0,0,8" FontSize="15" FontWeight="SemiBold" Text="设备列表" />

        <ListBox
          Grid.Row="1"
          ItemsSource="{Binding ViewModel.Devices, Mode=OneWay}"
          SelectedItem="{Binding ViewModel.SelectedDevice, Mode=TwoWay}"
        >
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:DeviceItem">
              <Border Margin="4,5" Padding="4" CornerRadius="4">
                <Border.Style>
                  <Style TargetType="Border">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsBusy}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                  <ui:SymbolIcon
                    Grid.Row="0" Grid.Column="0"
                    Width="{helpers:Scale 20}"
                    Height="{helpers:Scale 20}"
                    Symbol="Globe24"
                    VerticalAlignment="Center"
                  />
                  <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Name, Mode=OneWay}" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                      <Run Text="{Binding DeviceTypeText, Mode=OneWay}" />
                      <Run Text=" — " />
                      <Run Text="{Binding Address, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                  <!-- Progress bar visible during startup -->
                  <ProgressBar
                    Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                    Height="{helpers:Scale 6}"
                    Margin="0,6,0,2"
                    Maximum="100"
                    Minimum="0"
                    Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Value="{Binding StartupProgress, Mode=OneWay}"
                  />
                  <!-- Phase + detail text visible during startup -->
                  <TextBlock
                    Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                    FontSize="10"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                  >
                    <Run Text="{Binding StartupPhase, Mode=OneWay}" />
                    <Run Text=" — " />
                    <Run Text="{Binding StartupDetail, Mode=OneWay}" />
                  </TextBlock>
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <!-- Runtime state: busy (Cloning/Booting/Error/Stopping) -->
                  <Ellipse
                    Width="{helpers:Scale 10}"
                    Height="{helpers:Scale 10}"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                  >
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding RuntimeState}" Value="Cloning">
                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding RuntimeState}" Value="Booting">
                            <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding RuntimeState}" Value="Error">
                            <Setter Property="Fill" Value="#FFD13438" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding RuntimeState}" Value="Stopping">
                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                  <!-- Runtime state: Ready -->
                  <Ellipse
                    Width="{helpers:Scale 10}"
                    Height="{helpers:Scale 10}"
                    Margin="0,0,4,0"
                    Fill="#FF107C10"
                    VerticalAlignment="Center"
                  >
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding RuntimeState}" Value="Ready">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding RuntimeState}" Value="Off">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding RuntimeState}" Value="Cloning">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding RuntimeState}" Value="Booting">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding RuntimeState}" Value="Error">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding RuntimeState}" Value="Stopping">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                  <!-- Telnet connection indicator -->
                  <ui:SymbolIcon
                    Width="{helpers:Scale 14}"
                    Height="{helpers:Scale 14}"
                    Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                    Symbol="CheckmarkCircle24"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                  />
                </StackPanel>
              </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- Terminal Panel -->
    <Border
      Grid.Column="1"
      Margin="12,0,0,0"
      BorderBrush="{DynamicResource CardStrokeFillColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="6"
    >
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Device info + status bar -->
        <Border
          Grid.Row="0"
          Padding="12,10"
          Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
          CornerRadius="6,6,0,0"
        >
          <Grid>
            <TextBlock VerticalAlignment="Center" FontSize="14">
              <Run FontWeight="SemiBold" Text="{Binding ViewModel.SelectedDevice.Name, Mode=OneWay, FallbackValue='未选择设备'}" />
              <Run Text="  " />
              <Run
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding ViewModel.SelectedDevice.Address, Mode=OneWay, FallbackValue=''}"
              />
            </TextBlock>
            <TextBlock
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              FontSize="12"
              Text="{Binding ViewModel.StatusText, Mode=OneWay}"
            />
          </Grid>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="1" Margin="12,8" Orientation="Horizontal">
          <ui:Button
            Command="{Binding ViewModel.ConnectAllDevicesCommand, Mode=OneWay}"
            Content="一键连接全部"
            Icon="PlugConnected24"
            Appearance="Primary"
            IsEnabled="{Binding ViewModel.IsConnecting, Mode=OneWay, Converter={StaticResource InverseBool}}"
          />
          <ui:Button
            Margin="8,0,0,0"
            Command="{Binding ViewModel.DisconnectAllDevicesCommand, Mode=OneWay}"
            Content="断开全部"
            Icon="PlugDisconnected24"
          />
          <ui:Button
            Margin="16,0,0,0"
            Command="{Binding ViewModel.ConnectDeviceCommand, Mode=OneWay}"
            CommandParameter="{Binding ViewModel.SelectedDevice, Mode=OneWay}"
            Content="连接选中"
            Icon="Play24"
            IsEnabled="{Binding ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource InverseBool}}"
          />
          <ui:Button
            Margin="8,0,0,0"
            Command="{Binding ViewModel.DisconnectDeviceCommand, Mode=OneWay}"
            Content="断开选中"
            Icon="DismissCircle24"
            IsEnabled="{Binding ViewModel.IsConnected, Mode=OneWay}"
          />
          <Border Margin="16,4" Width="{helpers:Scale 1}" Background="{DynamicResource CardStrokeFillColorDefaultBrush}" />
          <!-- 设备启动：通过 eNSP 窗口图像识别自动点击右键菜单"启动" -->
          <ui:Button
            Margin="16,0,0,0"
            Command="{Binding ViewModel.StartAllDevicesCommand, Mode=OneWay}"
            Content="启动全部设备"
            Icon="Play24"
            Appearance="Success"
            ToolTip="通过 eNSP 窗口自动图像识别点击启动 — 请确保 eNSP 已打开对应拓扑"
            IsEnabled="{Binding ViewModel.IsStartingDevices, Mode=OneWay, Converter={StaticResource InverseBool}}"
          />
          <ui:Button
            Margin="8,0,0,0"
            Command="{Binding ViewModel.StopAllDevicesCommand, Mode=OneWay}"
            Content="停止全部"
            Icon="DismissCircle24"
          />
          <Border Margin="16,4" Width="{helpers:Scale 1}" Background="{DynamicResource CardStrokeFillColorDefaultBrush}" />
          <ui:Button
            Margin="16,0,0,0"
            Command="{Binding ViewModel.PushConfigToAllDevicesCommand, Mode=OneWay}"
            Content="一键配置全部"
            Icon="Send24"
            Appearance="Success"
            IsEnabled="{Binding ViewModel.IsPushing, Mode=OneWay, Converter={StaticResource InverseBool}}"
          />
          <ui:Button
            Margin="8,0,0,0"
            Command="{Binding ViewModel.PushConfigToSelectedDeviceCommand, Mode=OneWay}"
            Content="配置选中"
            Icon="ArrowSync24"
            IsEnabled="{Binding ViewModel.IsConnected, Mode=OneWay}"
          />
        </StackPanel>

        <!-- Terminal output -->
        <ScrollViewer
          Grid.Row="2"
          Margin="12,4"
          VerticalScrollBarVisibility="Auto"
        >
          <TextBlock
            Padding="4"
            FontFamily="Consolas, Courier New, monospace"
            FontSize="13"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="{Binding ViewModel.TerminalOutput, Mode=OneWay}"
            TextWrapping="Wrap"
          />
        </ScrollViewer>

        <!-- Command input -->
        <Border
          Grid.Row="3"
          Padding="12,8"
          Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
          CornerRadius="0,0,6,6"
        >
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
              Grid.Column="0"
              Margin="0,0,8,0"
              VerticalAlignment="Center"
              FontFamily="Consolas, Courier New, monospace"
              FontWeight="Bold"
              Text=">"
            />
            <TextBox
              Grid.Column="1"
              VerticalAlignment="Center"
              FontFamily="Consolas, Courier New, monospace"
              FontSize="13"
              Text="{Binding ViewModel.CommandInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            >
              <TextBox.InputBindings>
                <KeyBinding
                  Key="Enter"
                  Command="{Binding ViewModel.SendCommandCommand, Mode=OneWay}"
                />
              </TextBox.InputBindings>
            </TextBox>
            <ui:Button
              Grid.Column="2"
              Margin="8,0,0,0"
              Padding="8,6"
              Command="{Binding ViewModel.SendCommandCommand, Mode=OneWay}"
              Content="发送"
              Icon="Send24"
              IsEnabled="{Binding ViewModel.IsConnected, Mode=OneWay}"
            />
          </Grid>
        </Border>
      </Grid>
    </Border>
    </Grid>
  </Viewbox>
</Page>
