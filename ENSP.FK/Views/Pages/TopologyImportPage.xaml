<Page
  x:Class="ENSP.ZD.Views.Pages.TopologyImportPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:ENSP.ZD.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:helpers="clr-namespace:ENSP.ZD.Helpers"
  xmlns:topology="clr-namespace:ENSP.ZD.Models.Topology"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="拓扑导入"
  d:DataContext="{d:DesignInstance local:TopologyImportPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="600"
  d:DesignWidth="900"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  </Page.Resources>

  <Viewbox Stretch="Uniform" StretchDirection="UpOnly">
    <Grid Margin="24" Width="800">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock
      Grid.Row="0"
      Margin="0,0,0,16"
      FontSize="22"
      FontWeight="SemiBold"
      Text="拓扑导入"
    />

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBox
        Width="{helpers:Scale 400}"
        VerticalAlignment="Center"
        IsReadOnly="True"
        Text="{Binding ViewModel.FilePath, Mode=OneWay}"
      />
      <ui:Button
        Margin="8,0,0,0"
        VerticalAlignment="Center"
        Command="{Binding ViewModel.BrowseFileCommand, Mode=OneWay}"
        Content="浏览..."
        Icon="FolderOpen24"
      />
    </StackPanel>

    <TextBlock
      Grid.Row="2"
      Margin="0,0,0,12"
      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
      Text="{Binding ViewModel.StatusMessage, Mode=OneWay}"
    />

    <Grid Grid.Row="3" Visibility="{Binding ViewModel.IsLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <GroupBox Grid.Row="0" Header="设备">
        <ui:VirtualizingItemsControl ItemsSource="{Binding ViewModel.Devices, Mode=OneWay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type topology:Device}">
              <Border
                Padding="10,6"
                Margin="2"
                BorderBrush="{DynamicResource CardStrokeFillColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              >
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{Binding Name, Mode=OneWay}"
                  />
                  <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Type, Mode=OneWay}"
                  />
                  <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding Interfaces.Count, Mode=OneWay, StringFormat='{}{0} 个接口'}"
                  />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ui:VirtualizingItemsControl>
      </GroupBox>

      <GroupBox Grid.Row="2" Header="链路" Margin="0,12,0,0">
        <ui:VirtualizingItemsControl ItemsSource="{Binding ViewModel.Links, Mode=OneWay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type topology:TopologyLink}">
              <Border
                Padding="10,4"
                Margin="2"
                BorderBrush="{DynamicResource CardStrokeFillColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              >
                <TextBlock>
                  <Run Text="{Binding DeviceA, Mode=OneWay}" FontWeight="SemiBold" />
                  <Run Text=" [" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <Run Text="{Binding InterfaceA, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <Run Text="] ↔ " />
                  <Run Text="{Binding DeviceB, Mode=OneWay}" FontWeight="SemiBold" />
                  <Run Text=" [" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <Run Text="{Binding InterfaceB, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <Run Text="]" />
                </TextBlock>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ui:VirtualizingItemsControl>
      </GroupBox>
    </Grid>
    </Grid>
  </Viewbox>
</Page>
