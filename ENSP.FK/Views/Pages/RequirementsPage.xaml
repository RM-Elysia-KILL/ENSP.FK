<Page
  x:Class="ENSP.ZD.Views.Pages.RequirementsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helpers="clr-namespace:ENSP.ZD.Helpers"
  xmlns:local="clr-namespace:ENSP.ZD.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:req="clr-namespace:ENSP.ZD.Models.Requirements"
  xmlns:topology="clr-namespace:ENSP.ZD.Models.Topology"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="任务需求"
  d:DataContext="{d:DesignInstance local:RequirementsPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="650"
  d:DesignWidth="1000"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <helpers:StringEqualsConverter x:Key="StringEqualsConverter" />
  </Page.Resources>

  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <GroupBox Grid.Column="0" Header="设备">
      <ListBox
        ItemsSource="{Binding ViewModel.Devices, Mode=OneWay}"
        SelectedItem="{Binding ViewModel.SelectedDevice, Mode=TwoWay}"
      >
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type topology:Device}">
            <StackPanel Margin="2">
              <TextBlock FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" />
              <TextBlock
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                FontSize="11"
                Text="{Binding Type, Mode=OneWay}"
              />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </GroupBox>

    <Grid Grid.Column="1" Margin="16,0,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="120" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock
        Grid.Row="0"
        FontSize="18"
        FontWeight="SemiBold"
        Text="任务需求配置"
      />

      <!-- Freeform text area for AI -->
      <GroupBox Grid.Row="1" Header="自由文本描述（直接粘贴需求，AI 自动理解并生成配置）" Margin="0,10,0,0">
        <TextBox
          Margin="6"
          VerticalScrollBarVisibility="Auto"
          Text="{Binding ViewModel.RawRequirementText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          TextWrapping="Wrap"
          AcceptsReturn="True"
          FontSize="12"
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        />
      </GroupBox>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,8">
        <TextBlock
          VerticalAlignment="Center"
          Margin="0,0,8,0"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="结构化需求（可选）:"
        />
        <ComboBox
          Width="160"
          VerticalAlignment="Center"
          ItemsSource="{Binding ViewModel.RequirementTypes, Mode=OneWay}"
          SelectedItem="{Binding ViewModel.SelectedRequirementType, Mode=TwoWay}"
        />
        <ui:Button
          Margin="12,0,0,0"
          VerticalAlignment="Center"
          Command="{Binding ViewModel.AddRequirementCommand, Mode=OneWay}"
          Content="添加需求"
          Icon="Add24"
          Appearance="Primary"
        />
      </StackPanel>

      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
        <StackPanel>

          <GroupBox
            Height="160"
            Header="接口 IP 配置"
            Visibility="{Binding ViewModel.SelectedRequirementType, Mode=OneWay, Converter={StaticResource StringEqualsConverter}, ConverterParameter='接口 IP'}"
          >
            <StackPanel Margin="8">
              <TextBlock Margin="0,0,0,4" Text="接口名称" />
              <TextBox Margin="0,0,0,8" Text="{Binding ViewModel.IfName, Mode=TwoWay}" />
              <TextBlock Margin="0,0,0,4" Text="IP 地址" />
              <TextBox Margin="0,0,0,8" Text="{Binding ViewModel.IfIp, Mode=TwoWay}" />
              <TextBlock Margin="0,0,0,4" Text="子网掩码" />
              <TextBox Text="{Binding ViewModel.IfMask, Mode=TwoWay}" />
            </StackPanel>
          </GroupBox>

          <GroupBox
            Height="220"
            Header="VLAN 配置"
            Visibility="{Binding ViewModel.SelectedRequirementType, Mode=OneWay, Converter={StaticResource StringEqualsConverter}, ConverterParameter='VLAN'}"
          >
            <StackPanel Margin="8">
              <TextBlock Margin="0,0,0,4" Text="VLAN ID" />
              <TextBox Margin="0,0,0,8" Text="{Binding ViewModel.VlanId, Mode=TwoWay}" />
              <TextBlock Margin="0,0,0,4" Text="VLAN 名称（可选）" />
              <TextBox Margin="0,0,0,8" Text="{Binding ViewModel.VlanName, Mode=TwoWay}" />
              <TextBlock Margin="0,0,0,4" Text="Access 端口（逗号分隔）" />
              <TextBox Margin="0,0,0,8" Text="{Binding ViewModel.VlanAccessPorts, Mode=TwoWay}" />
              <TextBlock Margin="0,0,0,4" Text="Trunk 端口（逗号分隔）" />
              <TextBox Text="{Binding ViewModel.VlanTrunkPorts, Mode=TwoWay}" />
            </StackPanel>
          </GroupBox>

          <GroupBox
            Height="240"
            Header="OSPF 配置"
            Visibility="{Binding ViewModel.SelectedRequirementType, Mode=OneWay, Converter={StaticResource StringEqualsConverter}, ConverterParameter='OSPF'}"
          >
            <StackPanel Margin="8">
              <TextBlock Margin="0,0,0,4" Text="进程 ID" />
              <TextBox Margin="0,0,0,8" Text="{Binding ViewModel.OspfProcessId, Mode=TwoWay}" />
              <TextBlock Margin="0,0,0,4" Text="Router ID（可选）" />
              <TextBox Margin="0,0,0,8" Text="{Binding ViewModel.OspfRouterId, Mode=TwoWay}" />
              <TextBlock Margin="0,0,0,4" Text="区域 ID" />
              <TextBox Margin="0,0,0,8" Text="{Binding ViewModel.OspfAreaId, Mode=TwoWay}" />
              <TextBlock Margin="0,0,0,4" Text="网络列表（逗号分隔，如 10.0.0.0/24）" />
              <TextBox Text="{Binding ViewModel.OspfNetworks, Mode=TwoWay}" />
            </StackPanel>
          </GroupBox>

          <GroupBox
            Height="220"
            Header="静态路由配置"
            Visibility="{Binding ViewModel.SelectedRequirementType, Mode=OneWay, Converter={StaticResource StringEqualsConverter}, ConverterParameter='静态路由'}"
          >
            <StackPanel Margin="8">
              <TextBlock Margin="0,0,0,4" Text="目标网络" />
              <TextBox Margin="0,0,0,8" Text="{Binding ViewModel.RouteDest, Mode=TwoWay}" />
              <TextBlock Margin="0,0,0,4" Text="子网掩码" />
              <TextBox Margin="0,0,0,8" Text="{Binding ViewModel.RouteMask, Mode=TwoWay}" />
              <TextBlock Margin="0,0,0,4" Text="下一跳" />
              <TextBox Margin="0,0,0,8" Text="{Binding ViewModel.RouteNextHop, Mode=TwoWay}" />
              <TextBlock Margin="0,0,0,4" Text="出接口（可选）" />
              <TextBox Text="{Binding ViewModel.RouteOutIf, Mode=TwoWay}" />
            </StackPanel>
          </GroupBox>

          <GroupBox
            Height="220"
            Header="ACL 规则"
            Visibility="{Binding ViewModel.SelectedRequirementType, Mode=OneWay, Converter={StaticResource StringEqualsConverter}, ConverterParameter='ACL'}"
          >
            <StackPanel Margin="8">
              <TextBlock Margin="0,0,0,4" Text="ACL 编号" />
              <TextBox Margin="0,0,0,8" Text="{Binding ViewModel.AclNumber, Mode=TwoWay}" />
              <TextBlock Margin="0,0,0,4" Text="动作 (permit / deny)" />
              <TextBox Margin="0,0,0,8" Text="{Binding ViewModel.AclAction, Mode=TwoWay}" />
              <TextBlock Margin="0,0,0,4" Text="协议 (ip / tcp / udp / icmp)" />
              <TextBox Margin="0,0,0,8" Text="{Binding ViewModel.AclProtocol, Mode=TwoWay}" />
              <TextBlock Margin="0,0,0,4" Text="源 IP" />
              <TextBox Margin="0,0,0,8" Text="{Binding ViewModel.AclSource, Mode=TwoWay}" />
              <TextBlock Margin="0,0,0,4" Text="目标 IP" />
              <TextBox Text="{Binding ViewModel.AclDest, Mode=TwoWay}" />
            </StackPanel>
          </GroupBox>

        </StackPanel>
      </ScrollViewer>

      <TextBlock
        Grid.Row="4"
        Margin="0,8,0,0"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{Binding ViewModel.ReqStatus, Mode=OneWay}"
      />

      <GroupBox Grid.Row="5" Header="已添加的需求" Margin="0,12,0,0" MaxHeight="140">
        <ui:VirtualizingItemsControl ItemsSource="{Binding ViewModel.AddedRequirements, Mode=OneWay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type req:TaskRequirement}">
              <Border
                Padding="8,3"
                Margin="1"
                BorderBrush="{DynamicResource CardStrokeFillColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="3"
              >
                <StackPanel Orientation="Horizontal">
                  <TextBlock
                    Width="100"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{Binding DeviceName, Mode=OneWay}"
                  />
                  <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding RequirementType, Mode=OneWay}"
                  />
                  <ui:Button
                    Margin="8,0,0,0"
                    Width="22" Height="22"
                    VerticalAlignment="Center"
                    Appearance="Danger"
                    Icon="Delete12"
                    Command="{Binding DataContext.ViewModel.DeleteRequirementCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                    CommandParameter="{Binding}"
                  />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ui:VirtualizingItemsControl>
      </GroupBox>
    </Grid>
  </Grid>
</Page>
