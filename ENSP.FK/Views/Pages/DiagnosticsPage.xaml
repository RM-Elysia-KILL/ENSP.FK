<Page
  x:Class="ENSP.FK.Views.Pages.DiagnosticsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:ENSP.FK.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:services="clr-namespace:ENSP.FK.Services"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="调试"
  d:DataContext="{d:DesignInstance local:DiagnosticsPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <services:InstallStatusToSymbolConverter x:Key="StatusToSymbol" />
    <services:InstallStatusToColorConverter x:Key="StatusToColor" />
  </Page.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="环境调试" />
      <ui:Button
        Margin="16,0,0,0"
        VerticalAlignment="Center"
        Appearance="Primary"
        Command="{Binding ViewModel.RunCheckCommand, Mode=OneWay}"
        Content="重新检查"
        Icon="ArrowSync24"
      />
    </StackPanel>

    <TextBlock
      Grid.Row="1"
      Margin="0,0,0,12"
      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
      FontSize="12"
      Text="{Binding ViewModel.LastCheckTime, Mode=OneWay}"
    />

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding ViewModel.Results, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type services:AppStatus}">
            <Border
              Padding="16,12"
              Margin="0,0,0,8"
              BorderBrush="{DynamicResource CardStrokeFillColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="6"
            >
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon
                  Grid.Column="0"
                  Width="32"
                  Height="32"
                  Margin="0,0,16,0"
                  VerticalAlignment="Center"
                  Symbol="{Binding Installed, Converter={StaticResource StatusToSymbol}}"
                  Foreground="{Binding Installed, Converter={StaticResource StatusToColor}}"
                />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" />
                    <TextBlock Margin="8,0,0,0" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Version, Mode=OneWay}" />
                  </StackPanel>
                  <TextBlock
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Detail, Mode=OneWay}"
                  />
                  <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding InstallPath, Mode=OneWay}"
                  />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</Page>
