<Page
  x:Class="ENSP.ZD.Views.Pages.DiagnosticsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:ENSP.ZD.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:helpers="clr-namespace:ENSP.ZD.Helpers"
  xmlns:services="clr-namespace:ENSP.ZD.Services"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="调试"
  d:DataContext="{d:DesignInstance local:DiagnosticsPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <services:InstallStatusToSymbolConverter x:Key="StatusToSymbol" />
    <services:InstallStatusToColorConverter x:Key="StatusToColor" />
    <helpers:InverseBoolConverter x:Key="InverseBool" />
  </Page.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="环境调试" />
      <ui:Button
        Margin="16,0,0,0"
        VerticalAlignment="Center"
        Appearance="Primary"
        Command="{Binding ViewModel.RunCheckCommand, Mode=OneWay}"
        Content="重新检查"
        Icon="ArrowSync24"
      />
    </StackPanel>

    <TextBlock
      Grid.Row="1"
      Margin="0,0,0,12"
      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
      FontSize="12"
      Text="{Binding ViewModel.LastCheckTime, Mode=OneWay}"
    />

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding ViewModel.Results, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type services:AppStatus}">
            <Border
              Padding="16,12"
              Margin="0,0,0,8"
              BorderBrush="{DynamicResource CardStrokeFillColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="6"
            >
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon
                  Grid.Column="0"
                  Width="32"
                  Height="32"
                  Margin="0,0,16,0"
                  VerticalAlignment="Center"
                  Symbol="{Binding Installed, Converter={StaticResource StatusToSymbol}}"
                  Foreground="{Binding Installed, Converter={StaticResource StatusToColor}}"
                />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" />
                    <TextBlock Margin="8,0,0,0" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Version, Mode=OneWay}" />
                  </StackPanel>
                  <TextBlock
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Detail, Mode=OneWay}"
                  />
                  <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding InstallPath, Mode=OneWay}"
                  />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Log Viewer -->
    <Border
      Grid.Row="3"
      Margin="0,16,0,0"
      Padding="16,12"
      BorderBrush="{DynamicResource CardStrokeFillColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="6"
    >
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" FontSize="16" FontWeight="SemiBold" Text="运行日志" />
          <TextBlock
            Grid.Column="1"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            FontSize="11"
            Text="{Binding ViewModel.LogPathText, Mode=OneWay}"
          />
          <ui:Button
            Grid.Column="2"
            Command="{Binding ViewModel.RefreshLogCommand, Mode=OneWay}"
            Content="刷新"
            Icon="ArrowSync24"
          />
        </Grid>
        <TextBox
          Margin="0,8,0,0"
          Height="200"
          IsReadOnly="True"
          VerticalScrollBarVisibility="Auto"
          FontFamily="Consolas"
          FontSize="11"
          Text="{Binding ViewModel.LogContent, Mode=OneWay}"
          TextWrapping="NoWrap"
        />
      </StackPanel>
    </Border>
  </Grid>
</Page>
