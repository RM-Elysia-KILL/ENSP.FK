<Page
  x:Class="ENSP.FK.Views.Pages.ConfigOutputPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:ENSP.FK.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:models="clr-namespace:ENSP.FK.Models"
  xmlns:cfg="clr-namespace:ENSP.FK.Models.Configuration"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="配置输出"
  d:DataContext="{d:DesignInstance local:ConfigOutputPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="650"
  d:DesignWidth="1000"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <helpers:InverseBoolConverter x:Key="InverseBool" xmlns:helpers="clr-namespace:ENSP.FK.Helpers" />
  </Page.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" MinHeight="300" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock
        Grid.Column="0"
        VerticalAlignment="Center"
        FontSize="18"
        FontWeight="SemiBold"
        Text="配置输出"
      />

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <ui:Button
          VerticalAlignment="Center"
          Command="{Binding ViewModel.GenerateConfigsCommand, Mode=OneWay}"
          Content="生成配置"
          Icon="Play24"
          Appearance="Primary"
          IsEnabled="{Binding ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource InverseBool}}"
        />
        <ui:Button
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Command="{Binding ViewModel.ShowAllConfigsCommand, Mode=OneWay}"
          Content="显示全部"
          Icon="List24"
        />
        <ui:Button
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Command="{Binding ViewModel.CopyToClipboardCommand, Mode=OneWay}"
          Content="复制"
          Icon="Copy24"
        />
        <ui:Button
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Command="{Binding ViewModel.ExportToFilesCommand, Mode=OneWay}"
          Content="导出"
          Icon="Save24"
        />
        <ui:Button
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Command="{Binding ViewModel.ClearCacheCommand, Mode=OneWay}"
          Content="清除缓存"
          Icon="Delete24"
        />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <GroupBox Grid.Column="0" Header="设备">
        <ListBox
          ItemsSource="{Binding ViewModel.DeviceConfigs, Mode=OneWay}"
          SelectedItem="{Binding ViewModel.SelectedDeviceConfig, Mode=TwoWay}"
        >
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type cfg:DeviceConfig}">
              <StackPanel Margin="2,3" Orientation="Horizontal">
                <ui:SymbolIcon
                  Width="14" Height="14"
                  Margin="0,0,6,0"
                  Symbol="Server24"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                />
                <TextBlock VerticalAlignment="Center" Text="{Binding DeviceName, Mode=OneWay}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </GroupBox>

      <Border
        Grid.Column="1"
        Margin="12,0,0,0"
        BorderBrush="{DynamicResource CardStrokeFillColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4"
      >
        <TextBox
          x:Name="ConfigTextBox"
          Margin="8"
          Background="Transparent"
          BorderThickness="0"
          FontFamily="Consolas, Courier New, monospace"
          FontSize="12"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Auto"
          IsReadOnly="True"
          Text="{Binding ViewModel.ConfigText, Mode=OneWay}"
          TextWrapping="NoWrap"
        />
      </Border>
    </Grid>

    <Expander Grid.Row="2" Margin="0,8,0,0" Header="AI 实时对话" IsExpanded="True">
      <Border
        Height="240"
        BorderBrush="{DynamicResource CardStrokeFillColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4"
      >
        <ListBox
          x:Name="ChatListBox"
          Margin="8"
          Background="Transparent"
          BorderThickness="0"
          ItemsSource="{Binding ViewModel.ChatMessages, Mode=OneWay}"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
        >
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type models:ChatMessage}">
              <Border
                Margin="0,2"
                Padding="10,6"
                CornerRadius="6"
                MaxWidth="800"
              >
                <Border.Style>
                  <Style TargetType="Border">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsUser}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        <Setter Property="HorizontalAlignment" Value="Right" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsAi}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                        <Setter Property="HorizontalAlignment" Value="Left" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsStatus}" Value="True">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel>
                  <TextBlock
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                  >
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsUser}" Value="True">
                            <Setter Property="Text" Value="你" />
                            <Setter Property="Foreground" Value="White" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsAi}" Value="True">
                            <Setter Property="Text" Value="DeepSeek AI" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsStatus}" Value="True">
                            <Setter Property="Text" Value="系统" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock
                    FontSize="12"
                    Text="{Binding Content, Mode=OneWay}"
                    TextWrapping="Wrap"
                  >
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsUser}" Value="True">
                            <Setter Property="Foreground" Value="White" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock
                    FontSize="10"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding Timestamp, Mode=OneWay, StringFormat='{}{0:HH:mm:ss}'}"
                  />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Expander>

    <StackPanel
      Grid.Row="3"
      Margin="0,8,0,0"
      Orientation="Horizontal"
    >
      <TextBlock
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{Binding ViewModel.StatusMessage, Mode=OneWay}"
      />
      <TextBlock
        Margin="12,0,0,0"
        VerticalAlignment="Center"
        FontWeight="SemiBold"
        Foreground="{DynamicResource AccentFillColorDefaultBrush}"
        Text="{Binding ViewModel.ElapsedTime, Mode=OneWay}"
        Visibility="{Binding ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource BoolToVis}}"
      />
    </StackPanel>
  </Grid>
</Page>
