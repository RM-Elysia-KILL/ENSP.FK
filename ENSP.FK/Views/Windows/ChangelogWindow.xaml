<ui:FluentWindow
  x:Class="ENSP.ZD.Views.Windows.ChangelogWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:helpers="clr-namespace:ENSP.ZD.Helpers"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="ENSP.FK 更新公告"
  Width="{helpers:Scale 550}"
  Height="{helpers:Scale 600}"
  MinWidth="400"
  MinHeight="400"
  ExtendsContentIntoTitleBar="True"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner"
  WindowBackdropType="Mica"
>
  <Grid>
    <ui:TitleBar Title="ENSP.FK 更新公告" />
    <Grid Margin="0,48,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ScrollViewer
        Grid.Row="0"
        Margin="24,12"
        VerticalScrollBarVisibility="Auto"
      >
        <TextBlock
          FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
          FontSize="14"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
          Text="{Binding ViewModel.ChangelogContent, Mode=OneWay}"
          TextWrapping="Wrap"
        />
      </ScrollViewer>

      <ui:Button
        Grid.Row="1"
        Margin="24,8,24,16"
        Padding="16,8"
        Appearance="Primary"
        Command="{Binding ViewModel.CloseCommand}"
        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
        Content="知道了"
        HorizontalAlignment="Center"
      />
    </Grid>
  </Grid>
</ui:FluentWindow>
