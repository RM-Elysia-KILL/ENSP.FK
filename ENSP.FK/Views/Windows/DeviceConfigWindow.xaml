<ui:FluentWindow
    x:Class="ENSP.ZD.Views.Windows.DeviceConfigWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="clr-namespace:ENSP.ZD.Helpers"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:ENSP.ZD.ViewModels.Windows"
    xmlns:cfg="clr-namespace:ENSP.ZD.Models.Configuration"
    Title="{Binding WindowTitle}"
    Width="{helpers:Scale 680}" Height="{helpers:Scale 650}"
    MinWidth="550" MinHeight="500"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBoolConverter x:Key="InverseBool"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <ui:TitleBar Title="{Binding WindowTitle}" Grid.Row="0">
            <ui:TitleBar.Header>
                <TextBlock Text="{Binding WindowTitle}"
                           FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="12,4,0,0"/>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- TabControl -->
        <TabControl Grid.Row="1" Margin="8,4,8,8" Background="Transparent"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}">

            <!-- ═══ Tab 1: 配置编辑 ═══ -->
            <TabItem Header="配置编辑">
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="120" MaxWidth="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Config tree -->
                    <Border Grid.Column="0" CornerRadius="6" Padding="2"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="配置段" FontWeight="SemiBold" Margin="4,2" FontSize="12"/>
                            <TreeView Grid.Row="1" x:Name="ConfigTree"
                                      ItemsSource="{Binding ConfigTreeNodes}"
                                      Background="Transparent" BorderThickness="0" FontSize="11"
                                      SelectedItemChanged="ConfigTree_SelectedItemChanged">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="Padding" Value="2,2"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:ConfigTreeNode}" ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="11"/>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </Grid>
                    </Border>

                    <Separator Grid.Column="1" Width="{helpers:Scale 1}" Background="{DynamicResource ControlElevationBorderBrush}" Margin="4,6"/>

                    <!-- Right: Structured form panels -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Status bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,4"
                              Visibility="{Binding IsNetworkDevice, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ConfigStatus}" FontSize="9"
                                       Foreground="Gray" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <Button Grid.Column="1" Content="获取配置" Command="{Binding FetchConfigCommand}"
                                    Width="{helpers:Scale 72}" Height="{helpers:Scale 22}" FontSize="10" Margin="0,0,2,0"/>
                        </Grid>

                        <!-- Content panels -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                            <!-- ══ GLOBAL ══ -->
                            <StackPanel Visibility="{Binding IsContentGlobal, Converter={StaticResource BoolToVis}}">
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="全局配置" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <TextBlock Text="主机名" FontSize="10" Foreground="Gray" Margin="0,2,0,1"/>
                                        <TextBox Text="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Padding="6,3" FontFamily="Consolas"/>
                                        <TextBlock Text="MAC 地址" FontSize="10" Foreground="Gray" Margin="0,6,0,1"/>
                                        <TextBox Text="{Binding DeviceMac, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Padding="6,3" FontFamily="Consolas"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="保存" Command="{Binding SendGlobalConfigCommand}"
                                        Width="{helpers:Scale 80}" Height="{helpers:Scale 26}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                            </StackPanel>

                            <!-- ══ STATIC ROUTE ══ -->
                            <StackPanel Visibility="{Binding IsContentStaticRoute, Converter={StaticResource BoolToVis}}">
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="静态路由" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                                <TextBlock Text="目标网络" FontSize="10" Foreground="Gray"/>
                                                <TextBox Text="{Binding StaticRouteDest, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="4,2" FontFamily="Consolas"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,3,0">
                                                <TextBlock Text="掩码" FontSize="10" Foreground="Gray"/>
                                                <TextBox Text="{Binding StaticRouteMask, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="4,2" FontFamily="Consolas"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,3,0">
                                                <TextBlock Text="下一跳" FontSize="10" Foreground="Gray"/>
                                                <TextBox Text="{Binding StaticRouteNextHop, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="4,2" FontFamily="Consolas"/>
                                            </StackPanel>
                                            <Button Grid.Column="3" Content="+ 添加" Command="{Binding AddStaticRouteCommand}"
                                                    VerticalAlignment="Bottom" Width="{helpers:Scale 56}" Height="{helpers:Scale 24}" FontSize="10"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Static route table -->
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="8" Margin="0,0,0,4"
                                        Visibility="{Binding StaticRoutes.Count, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{helpers:Scale 24}"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="{helpers:Scale 50}"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="#" FontSize="10" Foreground="Gray"/>
                                            <TextBlock Grid.Column="1" Text="目标网络" FontSize="10" Foreground="Gray"/>
                                            <TextBlock Grid.Column="2" Text="掩码" FontSize="10" Foreground="Gray"/>
                                            <TextBlock Grid.Column="3" Text="下一跳" FontSize="10" Foreground="Gray"/>
                                            <TextBlock Grid.Column="4" Text="" FontSize="10"/>
                                        </Grid>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding StaticRoutes}" AlternationCount="1000">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type cfg:StaticRouteEntry}">
                                                    <Grid Margin="0,1,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{helpers:Scale 24}"/><ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="{helpers:Scale 50}"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" FontSize="10" Foreground="Gray"
                                                                   Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Dest}" FontSize="11" FontFamily="Consolas" Margin="2,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Mask}" FontSize="11" FontFamily="Consolas" Margin="2,0"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding NextHop}" FontSize="11" FontFamily="Consolas" Margin="2,0"/>
                                                        <Button Grid.Column="4" Content="x" FontSize="9" Width="{helpers:Scale 18}" Height="{helpers:Scale 18}"
                                                                Command="{Binding DataContext.DeleteStaticRouteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" ToolTip="删除"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <!-- CLI preview -->
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="CLI 预览" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding StaticRouteCliPreview, Mode=OneWay}" IsReadOnly="True"
                                                 FontSize="11" Padding="4" FontFamily="Consolas" MinHeight="30"
                                                 TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
                                                 Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="发送" Command="{Binding SendStaticRouteConfigCommand}"
                                        Width="{helpers:Scale 80}" Height="{helpers:Scale 26}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                            </StackPanel>

                            <!-- ══ RIP ══ -->
                            <StackPanel Visibility="{Binding IsContentRip, Converter={StaticResource BoolToVis}}">
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="RIP 配置" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{helpers:Scale 80}"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="版本" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" Text="{Binding RipVersion, UpdateSourceTrigger=PropertyChanged}"
                                                      FontSize="11" Margin="4,0" IsEditable="True">
                                                <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/>
                                            </ComboBox>
                                        </Grid>
                                        <TextBlock Text="网络地址" FontSize="10" Foreground="Gray" Margin="0,6,0,1"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding RipNetwork, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="4,2" FontFamily="Consolas"/>
                                            <Button Grid.Column="1" Content="+ 添加" Command="{Binding AddRipNetworkCommand}"
                                                    Width="{helpers:Scale 56}" Height="{helpers:Scale 24}" FontSize="10" Margin="6,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- RIP network table -->
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="8" Margin="0,0,0,4"
                                        Visibility="{Binding RipNetworks.Count, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <ItemsControl ItemsSource="{Binding RipNetworks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type cfg:RipNetworkEntry}">
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{helpers:Scale 50}"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Network}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="x" FontSize="9" Width="{helpers:Scale 18}" Height="{helpers:Scale 18}"
                                                            Command="{Binding DataContext.DeleteRipNetworkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- CLI preview -->
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="CLI 预览" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding RipCliPreview, Mode=OneWay}" IsReadOnly="True"
                                                 FontSize="11" Padding="4" FontFamily="Consolas" MinHeight="30"
                                                 TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
                                                 Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="发送" Command="{Binding SendRipConfigCommand}"
                                        Width="{helpers:Scale 80}" Height="{helpers:Scale 26}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                            </StackPanel>

                            <!-- ══ OSPF ══ -->
                            <StackPanel Visibility="{Binding IsContentOspf, Converter={StaticResource BoolToVis}}">
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="OSPF 配置" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                                <TextBlock Text="进程 ID" FontSize="10" Foreground="Gray"/>
                                                <TextBox Text="{Binding OspfProcessId, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="4,2" FontFamily="Consolas"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                                <TextBlock Text="Router ID" FontSize="10" Foreground="Gray"/>
                                                <TextBox Text="{Binding OspfRouterId, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="4,2" FontFamily="Consolas"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="区域 ID" FontSize="10" Foreground="Gray" Margin="0,4,0,1"/>
                                        <TextBox Text="{Binding OspfArea, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="4,2" FontFamily="Consolas" Width="{helpers:Scale 100}"/>
                                        <TextBlock Text="宣告网络" FontSize="10" Foreground="Gray" Margin="0,6,0,1"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding OspfNetwork, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="4,2" FontFamily="Consolas"/>
                                            <Button Grid.Column="1" Content="+ 添加" Command="{Binding AddOspfNetworkCommand}"
                                                    Width="{helpers:Scale 56}" Height="{helpers:Scale 24}" FontSize="10" Margin="6,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- OSPF network table -->
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="8" Margin="0,0,0,4"
                                        Visibility="{Binding OspfNetworks.Count, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <ItemsControl ItemsSource="{Binding OspfNetworks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type cfg:OspfNetworkEntry}">
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{helpers:Scale 60}"/><ColumnDefinition Width="{helpers:Scale 50}"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Network}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Area, StringFormat='area {0}'}" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Content="x" FontSize="9" Width="{helpers:Scale 18}" Height="{helpers:Scale 18}"
                                                            Command="{Binding DataContext.DeleteOspfNetworkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- CLI preview -->
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="CLI 预览" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding OspfCliPreview, Mode=OneWay}" IsReadOnly="True"
                                                 FontSize="11" Padding="4" FontFamily="Consolas" MinHeight="30"
                                                 TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
                                                 Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="发送" Command="{Binding SendOspfConfigCommand}"
                                        Width="{helpers:Scale 80}" Height="{helpers:Scale 26}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                            </StackPanel>

                            <!-- ══ BGP ══ -->
                            <StackPanel Visibility="{Binding IsContentBgp, Converter={StaticResource BoolToVis}}">
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="BGP 配置" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                                <TextBlock Text="AS 号" FontSize="10" Foreground="Gray"/>
                                                <TextBox Text="{Binding BgpAsNumber, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="4,2" FontFamily="Consolas"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                                <TextBlock Text="Router ID" FontSize="10" Foreground="Gray"/>
                                                <TextBox Text="{Binding BgpRouterId, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="4,2" FontFamily="Consolas"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="宣告网络" FontSize="10" Foreground="Gray" Margin="0,6,0,1"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding BgpNetwork, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="4,2" FontFamily="Consolas"/>
                                            <Button Grid.Column="1" Content="+ 添加" Command="{Binding AddBgpNetworkCommand}"
                                                    Width="{helpers:Scale 56}" Height="{helpers:Scale 24}" FontSize="10" Margin="6,0,0,0"/>
                                        </Grid>
                                        <TextBlock Text="Peer IP" FontSize="10" Foreground="Gray" Margin="0,6,0,1"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding BgpPeerIp, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="4,2" FontFamily="Consolas"/>
                                            <Button Grid.Column="1" Content="+ 添加" Command="{Binding AddBgpPeerCommand}"
                                                    Width="{helpers:Scale 56}" Height="{helpers:Scale 24}" FontSize="10" Margin="6,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- BGP entries -->
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8" Margin="0,0,0,4"
                                        Visibility="{Binding BgpNetworks.Count, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <ItemsControl ItemsSource="{Binding BgpNetworks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type cfg:BgpNetworkEntry}">
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{helpers:Scale 50}"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Network}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="x" FontSize="9" Width="{helpers:Scale 18}" Height="{helpers:Scale 18}"
                                                            Command="{Binding DataContext.DeleteBgpNetworkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- BGP CLI preview -->
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="CLI 预览" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding BgpCliPreview, Mode=OneWay}" IsReadOnly="True"
                                                 FontSize="11" Padding="4" FontFamily="Consolas" MinHeight="30"
                                                 TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
                                                 Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="发送" Command="{Binding SendBgpConfigCommand}"
                                        Width="{helpers:Scale 80}" Height="{helpers:Scale 26}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                            </StackPanel>

                            <!-- ══ IS-IS ══ -->
                            <StackPanel Visibility="{Binding IsContentIsis, Converter={StaticResource BoolToVis}}">
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="IS-IS 配置" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <TextBlock Text="System ID / NET" FontSize="10" Foreground="Gray"/>
                                        <TextBox Text="{Binding IsisSystemId, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="4,2" FontFamily="Consolas"/>
                                        <TextBlock Text="级别" FontSize="10" Foreground="Gray" Margin="0,4,0,1"/>
                                        <ComboBox Text="{Binding IsisLevel, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Width="{helpers:Scale 120}" IsEditable="True">
                                            <ComboBoxItem Content="level-1"/><ComboBoxItem Content="level-1-2"/><ComboBoxItem Content="level-2"/>
                                        </ComboBox>
                                        <TextBlock Text="NET 地址" FontSize="10" Foreground="Gray" Margin="0,6,0,1"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding IsisNetwork, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="4,2" FontFamily="Consolas"/>
                                            <Button Grid.Column="1" Content="+ 添加" Command="{Binding AddIsisNetworkCommand}"
                                                    Width="{helpers:Scale 56}" Height="{helpers:Scale 24}" FontSize="10" Margin="6,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="CLI 预览" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding IsisCliPreview, Mode=OneWay}" IsReadOnly="True"
                                                 FontSize="11" Padding="4" FontFamily="Consolas" MinHeight="30"
                                                 TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
                                                 Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="发送" Command="{Binding SendIsisConfigCommand}"
                                        Width="{helpers:Scale 80}" Height="{helpers:Scale 26}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                            </StackPanel>

                            <!-- ══ VLAN ══ -->
                            <StackPanel Visibility="{Binding IsContentVlan, Converter={StaticResource BoolToVis}}">
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="VLAN 配置" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                                <TextBlock Text="VLAN ID" FontSize="10" Foreground="Gray"/>
                                                <TextBox Text="{Binding VlanId, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="4,2" FontFamily="Consolas"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                                <TextBlock Text="名称" FontSize="10" Foreground="Gray"/>
                                                <TextBox Text="{Binding VlanName, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="4,2" FontFamily="Consolas"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="+ 添加" Command="{Binding AddVlanCommand}"
                                                    Width="{helpers:Scale 56}" Height="{helpers:Scale 24}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- VLAN table -->
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="8" Margin="0,0,0,4"
                                        Visibility="{Binding Vlans.Count, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <ItemsControl ItemsSource="{Binding Vlans}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type cfg:VlanEntry}">
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="{helpers:Scale 60}"/><ColumnDefinition Width="*"/><ColumnDefinition Width="{helpers:Scale 50}"/></Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                        <Run Text="VLAN "/><Run Text="{Binding VlanId}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" Margin="4,0"/>
                                                    <Button Grid.Column="2" Content="x" FontSize="9" Width="{helpers:Scale 18}" Height="{helpers:Scale 18}"
                                                            Command="{Binding DataContext.DeleteVlanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- VLAN CLI preview -->
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="CLI 预览" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding VlanCliPreview, Mode=OneWay}" IsReadOnly="True"
                                                 FontSize="11" Padding="4" FontFamily="Consolas" MinHeight="30"
                                                 TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
                                                 Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="发送" Command="{Binding SendVlanConfigCommand}"
                                        Width="{helpers:Scale 80}" Height="{helpers:Scale 26}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                            </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══ Tab 2: CLI 终端 ═══ -->
            <TabItem Header="CLI 终端">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Connection controls -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse Width="{helpers:Scale 10}" Height="{helpers:Scale 10}" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCliConnected}" Value="True">
                                            <Setter Property="Fill" Value="#4CAF50"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCliConnected}" Value="False">
                                            <Setter Property="Fill" Value="#9E9E9E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Button Content="连接" Command="{Binding ConnectCliCommand}" Width="{helpers:Scale 56}" Height="{helpers:Scale 24}" FontSize="11"
                                Visibility="{Binding IsCliConnected, Converter={StaticResource InverseBool}}"/>
                        <Button Content="断开" Command="{Binding DisconnectCliCommand}" Width="{helpers:Scale 56}" Height="{helpers:Scale 24}" FontSize="11"
                                Visibility="{Binding IsCliConnected, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding CliStatus}" FontSize="11" Foreground="Gray"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Terminal output -->
                    <Border Grid.Row="1" CornerRadius="4" Background="#FF1E1E1E" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding CliOutput, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="12" Foreground="#FF00FF00"
                                     Background="Transparent" BorderThickness="0"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Disabled"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Command input -->
                    <Border Grid.Row="2" Margin="0,4,0,0" Padding="4" CornerRadius="4" Background="#FF2A2A2A">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="13"
                                       Foreground="#FF00FF00" Text=">" Margin="4,0"/>
                            <TextBox Grid.Column="1" Margin="4,0" Padding="2" Background="Transparent" BorderThickness="0"
                                     CaretBrush="#FF00FF00" FontFamily="Consolas" FontSize="13" Foreground="#FF00FF00"
                                     Text="{Binding CliInput, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SendCliCommandCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Content="发送" Command="{Binding SendCliCommandCommand}"
                                    Width="{helpers:Scale 48}" Height="{helpers:Scale 24}" FontSize="11"
                                    IsEnabled="{Binding IsCliConnected}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ Tab 3: AI 生成 ═══ -->
            <TabItem Header="AI 生成">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="需求描述" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Grid.Row="1" Text="{Binding AiPrompt, UpdateSourceTrigger=PropertyChanged}"
                             Height="{helpers:Scale 80}" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontSize="12" Padding="6"
                             Background="{DynamicResource ApplicationBackgroundBrush}"/>

                    <Grid Grid.Row="1" Margin="0,84,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Content="生成配置" Command="{Binding GenerateAiConfigCommand}"
                                Width="{helpers:Scale 90}" Height="{helpers:Scale 28}" FontSize="12" Appearance="Primary"
                                IsEnabled="{Binding IsAiGenerating, Converter={StaticResource InverseBool}}"/>
                        <TextBlock Grid.Column="1" Text="{Binding AiStatus}" FontSize="11"
                                   Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="生成结果" FontWeight="SemiBold" Margin="0,8,0,4"/>
                    <Border Grid.Row="2" CornerRadius="4"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                            Margin="0,28,0,0">
                        <TextBox Text="{Binding AiResult, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11" Padding="6"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Border>

                    <ui:Button Grid.Row="3" Content="应用到设备" Command="{Binding ApplyAiConfigCommand}"
                            Width="{helpers:Scale 100}" Height="{helpers:Scale 28}" FontSize="12" Appearance="Success"
                            Margin="0,8,0,0" HorizontalAlignment="Right"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</ui:FluentWindow>
